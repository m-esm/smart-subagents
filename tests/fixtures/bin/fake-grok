#!/usr/bin/env python3
"""Fake grok CLI for characterization tests.

Records its own argv and cwd under $HOME/.ssa-test/fake-grok/, then emits a
JSON line that mimics `grok --output-format streaming-messages-json` closely
enough for the session-id scraper to find (or not find) `sessionId`.

Same control-file contract as fake-codex: $HOME/.ssa-test-control.json.
"""
import json
import os
import sys
from pathlib import Path

home = Path(os.environ.get("HOME") or ".")
recorder = home / ".ssa-test" / "fake-grok"
recorder.mkdir(parents=True, exist_ok=True)
(recorder / "argv.txt").write_text("\n".join(sys.argv[1:]) + ("\n" if sys.argv[1:] else ""))
(recorder / "cwd.txt").write_text(os.getcwd() + "\n")

control_path = home / ".ssa-test-control.json"
control = {}
if control_path.exists():
    try:
        control = json.loads(control_path.read_text())
    except Exception:
        control = {}

exit_code = int(control.get("exit_code", 0))
session_id = control.get("session_id", "fake-grok-session-000000000001")

# Same shape as the real CLI (2026-09-01): an init line carrying the session
# id, one full assistant message, then a result line whose `result` field is
# the final agent text. No -o flag exists, so last-msg.txt must come from here.
init = {"type": "system", "subtype": "init"}
if session_id:
    init["session_id"] = session_id
print(json.dumps(init))
print(json.dumps({"type": "assistant", "message": {"role": "assistant", "content": [
    {"type": "thinking", "thinking": "plan"},
    {"type": "text", "text": "working"},
    {"type": "tool_use", "name": "read_file", "input": {"target_file": "README.md"}},
]}}))
print(json.dumps({"type": "user", "message": {"role": "user", "content": [
    {"type": "tool_result", "content": "x" * 64},
]}}))
print(json.dumps({"type": "result", "subtype": "success", "num_turns": 2,
                  "result": "fake-grok final: ok"}))
sys.exit(exit_code)
