#!/usr/bin/env python3
"""Fake Claude Code CLI for characterization tests.

Records argv, cwd and env under $HOME/.ssa-test/fake-claude/, then emits one JSON
object shaped like `claude -p --output-format json` (a top-level session_id).
Same control-file contract as the other fakes: $HOME/.ssa-test-control.json.
Optional "output" is a dict printed as the JSON result object (budget-halt
tests set subtype error_max_budget_usd / is_error true / result null).
Optional "stderr" is written to stderr. When it is set and "output" is not a
dict, stdout is empty: that is the real dead-session resume (exit 1, a bare
"No conversation found with session ID: ..." line, no JSON envelope).
"""
import json
import os
import sys
from pathlib import Path

home = Path(os.environ.get("HOME") or ".")
recorder = home / ".ssa-test" / "fake-claude"
recorder.mkdir(parents=True, exist_ok=True)
(recorder / "argv.txt").write_text("\n".join(sys.argv[1:]) + ("\n" if sys.argv[1:] else ""))
(recorder / "cwd.txt").write_text(os.getcwd() + "\n")
(recorder / "env.json").write_text(json.dumps(dict(os.environ), sort_keys=True) + "\n")

control_path = home / ".ssa-test-control.json"
control = {}
if control_path.exists():
    try:
        control = json.loads(control_path.read_text())
    except Exception:
        control = {}

exit_code = int(control.get("exit_code", 0))
session_id = control.get("session_id", "fake-claude-session-000000000001")
stderr = control.get("stderr")
if stderr is not None:
    text = str(stderr)
    if text and not text.endswith("\n"):
        text += "\n"
    sys.stderr.write(text)
output = control.get("output")
if isinstance(output, dict):
    print(json.dumps(output))
elif stderr is None:
    print(json.dumps({"type": "result", "subtype": "success", "session_id": session_id}))
sys.exit(exit_code)
