#!/usr/bin/env bash
# opencode on an API-key provider, as a smart-subagents worker binary.
#
# One script, one profile per provider, picked by the name it is invoked
# under: scripts/opencode-cerebras and scripts/opencode-deepseek are symlinks
# to this file. Every argument goes to `opencode run`. This wrapper:
#   1. starts ssa/cerebras_proxy.py on an ephemeral 127.0.0.1 port. It injects
#      the API key from the profile's env file, so the worker process never
#      holds it. For Cerebras it also strips the echoed reasoning fields
#      Cerebras rejects; DeepSeek needs them echoed, so its profile does not;
#   2. points opencode's provider at that proxy through a throwaway
#      OPENCODE_CONFIG. The model entry is derived from the `-m provider/model`
#      argument the registry passes, so no model list lives here;
#   3. on macOS, confines opencode's file writes to the working directory,
#      TMPDIR and opencode's own state dirs with sandbox-exec (Seatbelt), the
#      same mechanism codex uses. That is what lets the registry call this
#      worker `sandbox: workspace`. On Linux bubblewrap (bwrap) does the same
#      job. With neither, the wrapper refuses to run unless
#      OPENCODE_CEREBRAS_NO_SANDBOX=1 accepts an unsandboxed run.
#
# Env: OPENCODE_BIN (override binary), OPENCODE_WORKER_NO_SANDBOX=1,
#      OPENCODE_WORKER_IDLE_TIMEOUT, OPENCODE_WORKER_MAX_SECONDS,
#      OPENCODE_WORKER_MAX_REQUESTS (watchdog, see below). The older
#      OPENCODE_CEREBRAS_* names are still read as fallbacks.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY="$HERE/ssa/cerebras_proxy.py"
ME="$(basename "${BASH_SOURCE[0]}")"
PROFILE="${OPENCODE_WORKER_PROFILE:-${ME#opencode-}}"
case "$PROFILE" in
  cerebras)
    UPSTREAM="https://api.cerebras.ai"
    KEY_FILE="$HOME/.config/cerebras/env"
    KEY_NAME="CEREBRAS_API_KEY"
    PROXY_FLAGS=()
    PROVIDER_NAME="Cerebras"
    MODEL_EXTRA=""
    DEFAULT_MODEL="gpt-oss-120b"
    ;;
  deepseek)
    UPSTREAM="https://api.deepseek.com"
    KEY_FILE="$HOME/.config/deepseek/env"
    KEY_NAME="DEEPSEEK_API_KEY"
    PROXY_FLAGS=(--no-strip)
    PROVIDER_NAME="DeepSeek"
    MODEL_EXTRA=', "tool_call": true, "reasoning": true'
    DEFAULT_MODEL="deepseek-flash"
    ;;
  *)
    echo "opencode-worker: unknown profile '$PROFILE' (invoke as opencode-cerebras or opencode-deepseek)" >&2
    exit 2
    ;;
esac
TAG="opencode-$PROFILE"
_env() {  # $1 = suffix, $2 = default: OPENCODE_WORKER_<suffix>, else the legacy name
  local new="OPENCODE_WORKER_$1" old="OPENCODE_CEREBRAS_$1"
  echo "${!new:-${!old:-$2}}"
}
OPENCODE_BIN="${OPENCODE_BIN:-$(command -v opencode || true)}"
[[ -n "$OPENCODE_BIN" ]] || { echo "$TAG: opencode not found on PATH (OPENCODE_BIN unset)" >&2; exit 127; }

WORKDIR="$PWD"
# `--dir X` in the args names the working tree the sandbox must let through.
# `-m provider/model` names the one model the throwaway config must declare.
_args=("$@")
MODEL="$DEFAULT_MODEL"
for ((i = 0; i < ${#_args[@]}; i++)); do
  if [[ "${_args[$i]}" == "--dir" && $((i + 1)) -lt ${#_args[@]} ]]; then
    WORKDIR="${_args[$((i + 1))]}"
  fi
  if [[ ( "${_args[$i]}" == "-m" || "${_args[$i]}" == "--model" ) && $((i + 1)) -lt ${#_args[@]} ]]; then
    MODEL="${_args[$((i + 1))]#"$PROFILE"/}"
  fi
done
[[ "$MODEL" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "$TAG: refusing model name '$MODEL'" >&2; exit 2; }
WORKDIR_RAW="$WORKDIR"
WORKDIR="$(cd "$WORKDIR" && pwd -P)"
# opencode treats any path that is not spelled exactly under its resolved
# project root as an "external directory" and auto-rejects the tool call in
# non-interactive runs. A worktree under $TMPDIR arrives as a symlinked,
# double-slashed path (/var/folders/...//smart-subagents/wt/...), so every
# argument that mentions the raw spelling is rewritten to the real path.
if [[ "$WORKDIR_RAW" != "$WORKDIR" ]]; then
  for ((i = 0; i < ${#_args[@]}; i++)); do
    _args[$i]="${_args[$i]//"$WORKDIR_RAW"/$WORKDIR}"
  done
fi
cd "$WORKDIR"

tmp="$(mktemp -d "${TMPDIR:-/tmp}/$TAG.XXXXXX")"
proxy_pid=""
cleanup() {
  [[ -n "$proxy_pid" ]] && kill "$proxy_pid" 2>/dev/null || true
  rm -rf "$tmp"
}
trap cleanup EXIT

python3 "$PROXY" --port-file "$tmp/port" --upstream "$UPSTREAM" --key-file "$KEY_FILE" \
  --key-name "$KEY_NAME" --label "$PROFILE-proxy" ${PROXY_FLAGS[@]+"${PROXY_FLAGS[@]}"} 2>"$tmp/proxy.log" &
proxy_pid=$!
for _ in $(seq 1 100); do
  [[ -s "$tmp/port" ]] && break
  if ! kill -0 "$proxy_pid" 2>/dev/null; then
    cat "$tmp/proxy.log" >&2
    echo "$TAG: proxy failed to start" >&2
    exit 2
  fi
  sleep 0.05
done
[[ -s "$tmp/port" ]] || { echo "$TAG: proxy never reported a port" >&2; exit 2; }
port="$(cat "$tmp/port")"

# Provider override: the key is a placeholder, the proxy adds the real one.
cat >"$tmp/opencode.json" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "$PROFILE": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "$PROVIDER_NAME (via smart-subagents proxy)",
      "options": { "baseURL": "http://127.0.0.1:$port/v1", "apiKey": "proxy" },
      "models": {
        "$MODEL": { "name": "$MODEL"$MODEL_EXTRA }
      }
    }
  }
}
EOF

# Watchdog: opencode has been seen to sit idle after its LLM loop without
# exiting, and the dispatcher has no wall-time cap of its own. Every LLM call
# passes through the proxy and lands in proxy.log, so "no request for
# IDLE seconds" (default 300; a tool call has a 120 s cap inside opencode)
# means a hang, not slow work. MAX_SECONDS (default 1800) bounds the run.
# MAX_REQUESTS (default 120) catches the other failure: a model that keeps
# calling tools without converging (qwen-3.8-27b was measured at 42 steps
# and climbing on a two-file task gpt-oss-120b finishes in 5).
IDLE="$(_env IDLE_TIMEOUT 300)"
MAX_SECONDS="$(_env MAX_SECONDS 1800)"
MAX_REQUESTS="$(_env MAX_REQUESTS 120)"
watchdog() {
  local pid="$1" started
  started="$(date +%s)"
  while kill -0 "$pid" 2>/dev/null; do
    sleep 5
    local now last
    now="$(date +%s)"
    last="$(stat -f %m "$tmp/proxy.log" 2>/dev/null || stat -c %Y "$tmp/proxy.log" 2>/dev/null || echo "$started")"
    if (( now - last > IDLE )); then
      echo "$TAG: no LLM request for ${IDLE}s, killing idle opencode (pid $pid)" >&2
      kill "$pid" 2>/dev/null; sleep 2; kill -9 "$pid" 2>/dev/null
      return
    fi
    local n
    n="$(grep -c "$PROFILE-proxy POST" "$tmp/proxy.log" 2>/dev/null || echo 0)"
    if (( n > MAX_REQUESTS )); then
      echo "$TAG: ${n} LLM requests exceed the ${MAX_REQUESTS} cap (model not converging), killing opencode (pid $pid)" >&2
      kill "$pid" 2>/dev/null; sleep 2; kill -9 "$pid" 2>/dev/null
      return
    fi
    if (( now - started > MAX_SECONDS )); then
      echo "$TAG: ${MAX_SECONDS}s wall-time cap reached, killing opencode (pid $pid)" >&2
      kill "$pid" 2>/dev/null; sleep 2; kill -9 "$pid" 2>/dev/null
      return
    fi
  done
}

run_opencode() {
  # stdin closed: `opencode run` otherwise waits on a non-tty stdin for a
  # piped message and never starts (measured 2026-09-25, zero output).
  OPENCODE_CONFIG="$tmp/opencode.json" "$@" "$OPENCODE_BIN" run --pure "${_args[@]}" </dev/null &
  local oc_pid=$!
  watchdog "$oc_pid" &
  local wd_pid=$!
  local rc=0
  wait "$oc_pid" || rc=$?
  kill "$wd_pid" 2>/dev/null
  wait "$wd_pid" 2>/dev/null || true
  return "$rc"
}

rc=0
if command -v sandbox-exec >/dev/null 2>&1; then
  home_real="$(cd "$HOME" && pwd -P)"
  tmp_real="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
  # Seatbelt: writes only where a worker legitimately needs them. Reads,
  # network and process spawning stay open (allow default).
  cat >"$tmp/sandbox.sb" <<EOF
(version 1)
(allow default)
(deny file-write*)
(allow file-write*
  (subpath "$WORKDIR")
  (subpath "$tmp_real")
  (subpath "$tmp")
  (subpath "/private/tmp")
  (subpath "/private/var/folders")
  (subpath "$home_real/.local/share/opencode")
  (subpath "$home_real/.local/state/opencode")
  (subpath "$home_real/.cache/opencode")
  (subpath "$home_real/.config/opencode")
  (subpath "$home_real/.bun")
  (subpath "$home_real/.cache/pytest")
  (literal "/dev/null")
  (literal "/dev/zero")
  (regex #"^/dev/tty")
  (regex #"^/dev/pty"))
EOF
  run_opencode sandbox-exec -f "$tmp/sandbox.sb" || rc=$?
elif command -v bwrap >/dev/null 2>&1 && bwrap --ro-bind / / --dev /dev true 2>/dev/null; then
  # Linux: bubblewrap gives the same shape as the Seatbelt profile. The whole
  # filesystem is read-only except the worktree, TMPDIR and opencode's own
  # state dirs. Network stays shared, so the loopback proxy is reachable.
  home_real="$(cd "$HOME" && pwd -P)"
  tmp_real="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
  bw=(bwrap --ro-bind / / --dev /dev --proc /proc --die-with-parent
    --bind "$WORKDIR" "$WORKDIR" --bind "$tmp_real" "$tmp_real" --bind "$tmp" "$tmp")
  for d in .local/share/opencode .local/state/opencode .cache/opencode .config/opencode .bun .cache/pytest; do
    mkdir -p "$home_real/$d"
    bw+=(--bind "$home_real/$d" "$home_real/$d")
  done
  run_opencode "${bw[@]}" -- || rc=$?
elif [[ "$(_env NO_SANDBOX "")" == "1" ]]; then
  echo "$TAG: no sandbox-exec or usable bwrap, running unsandboxed (OPENCODE_WORKER_NO_SANDBOX=1)" >&2
  run_opencode env || rc=$?
else
  echo "$TAG: no sandbox-exec (macOS) or usable bwrap (Linux); install bubblewrap or set OPENCODE_WORKER_NO_SANDBOX=1 to run without a write sandbox" >&2
  exit 3
fi
exit "$rc"
